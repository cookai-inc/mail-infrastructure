APP_NAME=CookAI Mail
APP_SHORT_NAME=CookAI
APP_DESCRIPTION=CookAI company email
LOGIN_COMPANY_NAME=CookAI Inc
JMAP_SERVER_URL=https://mail.cookai-inc.com
STALWART_FEATURES=true
ALLOW_CUSTOM_JMAP_ENDPOINT=false
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET_FILE=/run/secrets/bulwark-session
SETTINGS_SYNC_ENABLED=true
SETTINGS_DATA_DIR=/app/data/settings
ADMIN_CONFIG_DIR=/app/data/admin
ADMIN_CONFIG_READONLY=true
ADMIN_STATE_DIR=/app/data/admin-state
TELEMETRY_DATA_DIR=/app/data/telemetry
BULWARK_TELEMETRY=off
COOKIE_SECURE=true
TRUSTED_PROXY_DEPTH=1
LOG_FORMAT=json
LOG_LEVEL=info
HOSTNAME=0.0.0.0
PORT=3000
