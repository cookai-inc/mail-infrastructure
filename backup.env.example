RESTIC_REPOSITORY='s3:https://s3.example.net/cookai-mail-backups'
RESTIC_PASSWORD_FILE='/etc/cookai-mail/secrets/restic-password'
AWS_ACCESS_KEY_ID='replace-with-bucket-scoped-key-id'
AWS_SECRET_ACCESS_KEY='replace-with-bucket-scoped-secret'
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
RESTIC_CHECK_SUBSET_DIVISOR=30
STALWART_STOP_TIMEOUT_SECONDS=120
STALWART_START_TIMEOUT_SECONDS=180
